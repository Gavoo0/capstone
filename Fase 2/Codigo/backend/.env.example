# Configuración local del backend
PORT=4000
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=escuela_conductores

# Generar un valor aleatorio de al menos 32 caracteres para cada entorno
JWT_SECRET=

# Orígenes web permitidos. En producción indica el dominio publicado.
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5173
# Número exacto de proxies confiables delante del backend (déjalo vacío si no hay proxy).
TRUST_PROXY=

# Correo SMTP para recuperación de contraseña (obligatorio en producción).
FRONTEND_URL=http://localhost:4000
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
